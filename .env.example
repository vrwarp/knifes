# Copy to .env next to docker-compose.yml and fill in.

# Required: password for the GM console at /gm
GM_PASSWORD=change-me

# Required for live AI (ARCHIVE terminal, hint copilot, grader, case report).
# Leave empty to run everything in mock mode for rehearsals.
ANTHROPIC_API_KEY=

# Model for all four AI features.
CLAUDE_MODEL=claude-opus-5-5

# Optional. If set, the player link must be opened once as https://your-host/?k=THIS
# (put it in the QR code). Keeps strangers off the terminal.
PLAYER_KEY=

# Optional. Random string so GM logins survive container restarts.
SESSION_SECRET=

# Set to 1 when the site is served over https (it is, behind your reverse proxy).
COOKIE_SECURE=1

# Optional: force mock AI even with a key present.
# AI_MODE=mock
