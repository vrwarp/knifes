# Copy to .env next to docker-compose.yml and fill in.

# Required: password for the GM console at /gm
GM_PASSWORD=change-me

# ---- Claude credential: pick ONE of the three options ----
# A) Your Claude subscription (Pro or Max). On a machine where Claude Code is
#    installed run `claude setup-token`, approve in the browser, and paste the
#    printed token here. It lasts a year. Leave ANTHROPIC_API_KEY empty.
CLAUDE_CODE_OAUTH_TOKEN=

# B) An API key from platform.claude.com, billed per token.
#    If both A and B are set, Claude Code uses the API key.
ANTHROPIC_API_KEY=

# C) Nothing here. After the container is up, sign in once inside it:
#      docker compose exec section30 claude auth login
#    and paste the code the browser shows. The login is kept in the data volume.

# With no credential at all the app runs every feature in mock mode.

# Model for all four AI features.
CLAUDE_MODEL=claude-opus-5-5

# Optional. If set, the player link must be opened once as https://your-host/?k=THIS
# (put it in the QR code). Keeps strangers off the terminal.
PLAYER_KEY=

# Optional. Random string so GM logins survive container restarts.
SESSION_SECRET=

# Set to 1 when the site is served over https (it is, behind your reverse proxy).
COOKIE_SECURE=1

# Optional. Google Maps browser key for the location puzzle. When set, the player
# gets a GeoGuessr-style Street View panorama at the target (address and road
# labels hidden) instead of, or as well as, uploaded field photos. Create it in
# Google Cloud console with the "Maps JavaScript API" enabled, and restrict it
# to your host as an HTTP referrer: the key is sent to the player's browser.
# A handful of loads for one game fits in Google's free monthly allowance.
GOOGLE_MAPS_API_KEY=

# Optional: force mock AI even with a credential present.
# AI_MODE=mock
